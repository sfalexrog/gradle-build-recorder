{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GradleBuildRecord",
    "type": "object",
    "properties": {
        "invocation": {
            "type": "object",
            "properties": {
                "projectPath": {
                    "type": "string"
                },
                "gradleArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "result": {
                    "$ref": "#/$defs/invocation.com.github.sfalexrog.gradlebuildrecorder.models.GradleBuildResult"
                },
                "startTime": {
                    "type": "integer"
                },
                "endTime": {
                    "type": "integer"
                }
            },
            "additionalProperties": false,
            "required": [
                "projectPath",
                "gradleArgs",
                "result",
                "startTime",
                "endTime"
            ]
        },
        "fileDownloadEvents": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "startTime": {
                        "type": "integer"
                    },
                    "endTime": {
                        "type": "integer"
                    },
                    "uri": {
                        "type": "string"
                    },
                    "bytesDownloaded": {
                        "type": "integer"
                    },
                    "result": {
                        "$ref": "#/$defs/download.com.github.sfalexrog.gradlebuildrecorder.models.FileDownloadResult"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "startTime",
                    "endTime",
                    "uri",
                    "bytesDownloaded",
                    "result"
                ]
            }
        },
        "taskExecutionEvents": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "taskPath": {
                        "type": "string"
                    },
                    "originPlugin": {
                        "type": "string"
                    },
                    "dependencies": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "event": {
                        "$ref": "#/$defs/task.com.github.sfalexrog.gradlebuildrecorder.models.TaskCompletionEvent"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "taskPath",
                    "originPlugin",
                    "dependencies",
                    "event"
                ]
            }
        },
        "stdoutLines": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "startTime": {
                        "type": "integer"
                    },
                    "endTime": {
                        "type": "integer"
                    },
                    "line": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "startTime",
                    "endTime",
                    "line"
                ]
            }
        },
        "stderrLines": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "startTime": {
                        "type": "integer"
                    },
                    "endTime": {
                        "type": "integer"
                    },
                    "line": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "startTime",
                    "endTime",
                    "line"
                ]
            }
        }
    },
    "additionalProperties": false,
    "required": [
        "invocation",
        "fileDownloadEvents",
        "taskExecutionEvents",
        "stdoutLines",
        "stderrLines"
    ],
    "$defs": {
        "invocation.com.github.sfalexrog.gradlebuildrecorder.models.GradleBuildResult": {
            "oneOf": [
                {
                    "$ref": "#/$defs/invocation.build_cancelled"
                },
                {
                    "$ref": "#/$defs/invocation.build_failure"
                },
                {
                    "$ref": "#/$defs/invocation.gradle_connection_error"
                },
                {
                    "$ref": "#/$defs/invocation.success"
                },
                {
                    "$ref": "#/$defs/invocation.unsupported_build_argument"
                },
                {
                    "$ref": "#/$defs/invocation.unsupported_gradle_version"
                },
                {
                    "$ref": "#/$defs/invocation.unsupported_operation_configuration"
                }
            ]
        },
        "invocation.build_cancelled": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "build_cancelled"
                },
                "message": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "message"
            ],
            "additionalProperties": false
        },
        "invocation.build_failure": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "build_failure"
                },
                "message": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "message"
            ],
            "additionalProperties": false
        },
        "invocation.gradle_connection_error": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "gradle_connection_error"
                },
                "message": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "message"
            ],
            "additionalProperties": false
        },
        "invocation.success": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "success"
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "invocation.unsupported_build_argument": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "unsupported_build_argument"
                },
                "message": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "message"
            ],
            "additionalProperties": false
        },
        "invocation.unsupported_gradle_version": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "unsupported_gradle_version"
                },
                "message": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "message"
            ],
            "additionalProperties": false
        },
        "invocation.unsupported_operation_configuration": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "unsupported_operation_configuration"
                },
                "message": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "message"
            ],
            "additionalProperties": false
        },
        "task.com.github.sfalexrog.gradlebuildrecorder.models.TaskCompletionEvent": {
            "oneOf": [
                {
                    "$ref": "#/$defs/task.failed"
                },
                {
                    "$ref": "#/$defs/task.skipped"
                },
                {
                    "$ref": "#/$defs/task.success"
                }
            ]
        },
        "task.failed": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "failed"
                },
                "startTime": {
                    "type": "integer"
                },
                "endTime": {
                    "type": "integer"
                },
                "failures": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "type",
                "startTime",
                "endTime",
                "failures"
            ],
            "additionalProperties": false
        },
        "task.skipped": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "skipped"
                },
                "startTime": {
                    "type": "integer"
                },
                "endTime": {
                    "type": "integer"
                },
                "reason": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "startTime",
                "endTime",
                "reason"
            ],
            "additionalProperties": false
        },
        "task.success": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "success"
                },
                "startTime": {
                    "type": "integer"
                },
                "endTime": {
                    "type": "integer"
                },
                "isUpToDate": {
                    "type": "boolean"
                },
                "isFromCache": {
                    "type": "boolean"
                }
            },
            "required": [
                "type",
                "startTime",
                "endTime",
                "isUpToDate",
                "isFromCache"
            ],
            "additionalProperties": false
        },
        "download.com.github.sfalexrog.gradlebuildrecorder.models.FileDownloadResult": {
            "oneOf": [
                {
                    "$ref": "#/$defs/download.failure"
                },
                {
                    "$ref": "#/$defs/download.not_found"
                },
                {
                    "$ref": "#/$defs/download.success"
                }
            ]
        },
        "download.failure": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "failure"
                },
                "messages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "type",
                "messages"
            ],
            "additionalProperties": false
        },
        "download.not_found": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "not_found"
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "download.success": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "success"
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        }
    }
}
